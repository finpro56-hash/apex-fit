rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid}/profile/{profileId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/goals/{goalId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/foodLogs/{foodLogId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/workoutPlans/{planId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/workoutSessions/{sessionId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/progress/{progressId} {
      allow read, write: if isOwner(uid);
    }
  }
}
